# 默认使用通义千问；需要时可改为 deepseek
AI_PROVIDER=qwen

# DeepSeek（服务端读取，不会暴露到浏览器）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# 使用平台共享密钥时允许的模型；逗号分隔。留空时只允许 DEEPSEEK_MODEL。
DEEPSEEK_SHARED_MODELS=

# 通义千问 / 阿里云百炼
QWEN_API_KEY=
# 无业务空间域名时可继续使用下方兼容入口；生产环境建议替换为百炼控制台给出的地域专属地址
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
# 使用平台共享密钥时允许的模型；逗号分隔。留空时只允许 QWEN_MODEL。
QWEN_SHARED_MODELS=

# Token 费用仅用于用量报表与预算告警。价格会变化，请填写控制台当前的“每百万 Token 人民币价格”。
# 未填写时仍限制 Token 数量，但费用字段会留空，避免使用过期价格误导。
QWEN_INPUT_COST_CNY_PER_M_TOKENS=
QWEN_OUTPUT_COST_CNY_PER_M_TOKENS=
DEEPSEEK_INPUT_COST_CNY_PER_M_TOKENS=
DEEPSEEK_OUTPUT_COST_CNY_PER_M_TOKENS=

# true：始终使用内置演示数据；false：有密钥时调用真实模型，无密钥时自动回退演示模式
DEMO_MODE=false

# 生产环境默认不允许匿名用户消耗上面的服务端共享密钥。
# 仅在已经配置外部限流、预算告警并明确接受公开费用风险时设为 true。
ALLOW_PUBLIC_AI_API=false

# 生产环境默认关闭网页临时 API 密钥，避免 Serverless 多实例丢失或错用。
# 只有在确认使用单实例部署并接受进程重启后丢失时才设为 true。
ALLOW_RUNTIME_API_KEYS=false

# 可选：Supabase Auth + PostgreSQL 云同步。不填写时保持本地模式，全部 Agent 仍可运行。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 生产域名，用于邮件确认和密码重置回调，例如 https://example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 可选本地、生产必需：Cloudflare Turnstile 公共 Site Key。Secret Key 只填写到 Supabase Auth 控制台。
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# 推荐使用当前的 sb_secret_... Secret Key；仅服务端账号删除接口使用。
# 绝不能添加 NEXT_PUBLIC_ 前缀或提交真实值。
SUPABASE_SECRET_KEY=
# 旧项目兼容变量；仅当控制台尚未提供 Secret Key 时使用，计划在 2026 年底前迁移。
SUPABASE_SERVICE_ROLE_KEY=

# 生产安全与运维。两个 Secret 建议分别生成 32 字节以上的随机值。
# RATE_LIMIT_HASH_SECRET 用来把 IP/客户端标识转换为不可逆摘要，数据库不会保存原始 IP。
RATE_LIMIT_HASH_SECRET=
# 访问 GET /api/health?deep=1 时作为 Bearer Token；普通 /api/health 不需要密钥。
HEALTHCHECK_SECRET=
# 接收预算阈值和故障告警的 HTTPS Webhook。载荷不包含简历、JD 或对话正文。
AI_ALERT_WEBHOOK_URL=

# 企业公开岗位源。每项格式为「招聘站标识|展示公司名」，多项用英文逗号分隔；留空可关闭该类来源。
LIVE_JOBS_ENABLED=true
LIVE_JOBS_CACHE_MINUTES=60
LIVE_JOBS_MAX_PER_SOURCE=150
GREENHOUSE_BOARDS=anthropic|Anthropic
LEVER_SITES=spotify|Spotify
ASHBY_BOARDS=OpenAI|OpenAI

# 可选聚合源；不填写时不会请求 Adzuna，也不会产生该服务用量。
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb
ADZUNA_QUERY=intern graduate

# Vercel Cron 用于保护岗位刷新接口。请在部署环境生成随机长字符串，本地无需填写。
CRON_SECRET=

# 可选：仅用于本地/CI 的 Supabase 真实隔离测试。请使用两个专用测试账号，不要使用真实用户账号。
# 填写专用测试账号并将开关改为 true 后执行 pnpm test:supabase:live。
RUN_LIVE_SUPABASE_E2E=false
SUPABASE_TEST_USER_A_EMAIL=
SUPABASE_TEST_USER_A_PASSWORD=
SUPABASE_TEST_USER_B_EMAIL=
SUPABASE_TEST_USER_B_PASSWORD=
