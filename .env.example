# 模型提供商默认值：deepseek 或 qwen
AI_PROVIDER=deepseek

# DeepSeek（服务端读取，不会暴露到浏览器）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 通义千问 / 阿里云百炼
QWEN_API_KEY=
# 无业务空间域名时可继续使用下方兼容入口；生产环境建议替换为百炼控制台给出的地域专属地址
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# true：始终使用内置演示数据；false：有密钥时调用真实模型，无密钥时自动回退演示模式
DEMO_MODE=false

# 可选：Supabase Auth + PostgreSQL 云同步。不填写时保持本地模式，全部 Agent 仍可运行。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
