{
  "name": "zhihang-career-agents",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:evals": "vitest run tests/prompt-evals.test.ts",
    "test:evals:live": "node scripts/run-live-evals.mjs",
    "test:e2e": "playwright test",
    "test:supabase:live": "node --env-file=.env.local node_modules/@playwright/test/cli.js test e2e/supabase-live.spec.ts e2e/email-confirmation-live.spec.ts",
    "test:supabase:production": "node scripts/run-production-supabase-e2e.mjs",
    "check:production": "node --env-file-if-exists=.env.local scripts/check-production-env.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "docx": "9.7.2",
    "lucide-react": "1.48.0",
    "mammoth": "1.13.0",
    "next": "16.3.6",
    "pdf-parse": "2.4.5",
    "pdfkit": "0.20.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/pdfkit": "0.17.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "pdf-lib": "1.17.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
